# Database
POSTGRES_DB=aqs_crm
POSTGRES_USER=aqs_user
POSTGRES_PASSWORD=changeme
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/aqs_crm
SPRING_DATASOURCE_USERNAME=aqs_user
SPRING_DATASOURCE_PASSWORD=changeme

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aqs-po-documents
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000

# SMTP Configuration (GoDaddy / Gmail / Office 365)
# Option 1: GoDaddy SSL (Port 465)
SPRING_MAIL_HOST=smtpout.secureserver.net
SPRING_MAIL_PORT=465
SPRING_MAIL_PROTOCOL=smtp
SPRING_MAIL_USERNAME=noreply@yourdomain.com
SPRING_MAIL_PASSWORD=changeme
SPRING_MAIL_FROM=noreply@yourdomain.com
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_SSL_ENABLE=true

# Option 2: GoDaddy / TLS (Port 587)
# SPRING_MAIL_HOST=smtpout.secureserver.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_PROTOCOL=smtp
# SPRING_MAIL_USERNAME=noreply@yourdomain.com
# SPRING_MAIL_PASSWORD=changeme
# SPRING_MAIL_FROM=noreply@yourdomain.com
# SPRING_MAIL_STARTTLS_ENABLE=true
# SPRING_MAIL_SSL_ENABLE=false

# App
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata
